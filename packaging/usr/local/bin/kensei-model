#!/usr/bin/env bash
# Descarga el GGUF abliterado y crea el modelo Ollama `kensei`.
# Idempotente: si el GGUF existe y el hash coincide, no vuelve a descargar.
set -Eeuo pipefail

PREFIX="${KENSEI_PREFIX:-/usr/local}"
DATA_DIR="${KENSEI_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/kensei}"
MODEL_DIR="$DATA_DIR/models"
GGUF="$MODEL_DIR/kensei-abliterated-Q4_K_M.gguf"
URL="https://huggingface.co/bartowski/Qwen2.5-Coder-7B-Instruct-abliterated-GGUF/resolve/main/Qwen2.5-Coder-7B-Instruct-abliterated-Q4_K_M.gguf"
SHA256="FDF02C16FB654FF60B2C30F1E91573EBC603A7084DF3449DF89120DCA2B18170"

mkdir -p "$MODEL_DIR"
if [[ -f "$GGUF" ]]; then
  echo "[kensei-model] GGUF existente: $GGUF"
else
  echo "[kensei-model] descargando $URL"
  curl -L --fail --retry 3 --progress-bar -o "$GGUF.part" "$URL"
  echo "$SHA256  $GGUF.part" | sha256sum -c -
  mv "$GGUF.part" "$GGUF"
fi

for _ in {1..30}; do
  if ollama list >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
if ! ollama list >/dev/null 2>&1; then
  echo "[kensei-model] Ollama no responde en 127.0.0.1:11434" >&2
  exit 1
fi

python3 "$PREFIX/lib/kensei/scripts/create_base_model.py" \
  --gguf "$GGUF" \
  --name "${KENSEI_MODEL:-kensei}" \
  --out-dir "$MODEL_DIR"

touch "$MODEL_DIR/.kensei-model-ready"
echo "[kensei-model] listo: ${KENSEI_MODEL:-kensei}"
